---
import MainLayout from "../layouts/MainLayout.astro";
import Textcols from "../components/Textcols.astro";
import Heading from "../components/Heading.astro";
import Starhover from "../components/Starhover.astro";

const items = [
  {
    type: "image",
    src: "/lykke.webp",
    alt: "Billede af Lykke Neiiendam.",
    caption: "Lykke Neiiendam",
  },
  {
    type: "image",
    src: "/malene.webp",
    alt: "Billede af Malene Eikers.",
    caption: "Malene Eikers",
  },
  {
    type: "image",
    src: "/line.webp",
    alt: "Billede af Line Gamborg.",
    caption: "Line Gamborg",
  },
  {
    type: "image",
    src: "/lotte.webp",
    alt: "Billede af Lotte Dyva-Toubo.",
    caption: "Lotte Dyva-Toubo",
  },
];
---

<MainLayout title="Contact">
  <Textcols title="Contact" textVers={1}>
    <Heading htmlheading="h2" size="medium">
      We’d love to hear from you. Whether you have an idea, a project in mind or
      just want to say hello, feel free to reach out — we’re always open,
      curious and ready for a good conversation.</Heading
    >
  </Textcols>
  <div class="flex flex-row gap-xl">
    <Heading
      htmlheading="h3"
      size="large"
      stylingclasses="py-gutter vertical-text lg:hidden"
      >Bermuda@invoicedrop.com</Heading
    >
    <div class="lg:hidden">
      <Starhover />
    </div>
  </div>
  <Heading
    htmlheading="h3"
    size="large"
    stylingclasses="hidden lg:px-xl lg:block lg:pb-5xl"
    >Bermuda@invoicedrop.com</Heading
  >

  <Heading
    htmlheading="h2"
    size="medium"
    stylingclasses="px-gutter pt-2xl pb-xl lg:pb-2xl lg:-0 lg:px-xl "
    >Four women behind Bermuda</Heading
  >
  <div
    class="grid grid-cols-2 lg:grid-cols-4 px-gutter pb-4xl lg:pb-5xl lg:px-xl gap-sm lg:gap-gutter"
  >
    {
      items.map((item, index) => (
        <div class="pb-gutter">
          <img src={item.src} alt={item.alt} />

          <Heading
            htmlheading="h3"
            size="xs"
            weight="medium"
            stylingclasses="pt-sm"
          >
            {item.caption}
          </Heading>
        </div>
      ))
    }
  </div>
</MainLayout>
