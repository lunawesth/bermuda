---
import MainLayout from "../layouts/MainLayout.astro";
import Heading from "../components/Heading.astro";
import Text from "../components/Text.astro";
import Button from "../components/Button.astro";
import Breaker from "../components/Breaker.astro";
import Border from "../components/Border.astro";
import Starhover from "../components/Starhover.astro";
import Loader from "../components/Loader.astro";
---

<MainLayout title="Frontpage">
  <Loader />

  <section class="px-gutter lg:px-xl grid grid-cols-2 lg:grid-cols-4">
    <div class="col-span-2 pb-3xl lg:col-span-3">
      <Heading htmlheading="h1" size="xlarge"
        >We create engaging content across news, lifestyle and reality, from
        documentaries to high-end campaigns.</Heading
      >
    </div>
    <div class="row-end-3">
      <img src="/arrow.png" alt="Pil ned" class="h-25" />
    </div>
    <div class="pb-4xl row-end-3 lg:col-start-4">
      <div>
        <Text variant="bodybold" stylingclasses="pb-sm lg:pb-xl"
          >A Copenhagen based full-service creative production company.</Text
        >
      </div>
      <Button href="about">about us</Button>
    </div>
  </section>
  <section>
    <video width="full" height="full" autoplay muted loop playsinline>
      <source src="/Bermuda-video.mp4" type="video/mp4" />
      Din browser understøtter ikke dette video-tag.
    </video>
    <Breaker
      titleTop="Curious?"
      titleBottom="Well, check out our work."
      link="work"
      text="see more"
    />
  </section>
  <Border />
  <section
    class="px-gutter lg:px-xl pt-3xl pb-2xl grid lg:grid-cols-12 lg:grid-rows-2"
  >
    <div class="lg:col-span-4 lg:row-span-1">
      <Heading
        htmlheading="h2"
        size="xxlarge"
        stylingclasses="pb-gutter lg:pb-lg">Our services</Heading
      >
      <div class="hidden lg:block lg:pb-2xl">
        <Button href="services">read more</Button>
      </div>
    </div>
    <div
      class="lg:col-start-8 lg:col-end-13 lg:row-span-1 lg:place-self-center"
    >
      <Text variant="bodybold" stylingclasses="pb-md"
        >We're a passionate and dedicated team that approaches every project
        with the same energy and care, no matter the scale, always striving to
        create meaningful and engaging productions together.</Text
      >
    </div>
    <div class="lg:hidden">
      <Button href="services">read more</Button>
    </div>

    <!-- drop down starter her -->
    <section
      class="pt-2xl lg:pt-md lg:col-start-8 lg:col-end-13 lg:row-start-2"
    >
      <div class="border-t lg:border-t-2 border-primary">
        <!-- ITEM -->
        <div class="accordion-item border-b lg:border-b-2 border-primary">
          <button
            class="accordion-toggle w-full flex items-center justify-between py-md text-left"
          >
            <span
              ><Heading
                htmlheading="h3"
                stylingclasses="cursor-hover"
                size="medium">Development</Heading
              ></span
            >

            <img
              src="/arrow-2.png"
              alt="Arrow"
              class="accordion-arrow h-4 transition-transform duration-300"
            />
          </button>

          <div
            class="accordion-content grid grid-rows-[0fr] transition-all duration-300 ease-in-out"
          >
            <div class="overflow-hidden">
              <Text variant="bodysmall" stylingclasses="pb-md">
                We develop creative concepts and formats for brands and
                broadcasters.
              </Text>
            </div>
          </div>
        </div>

        <!-- ITEM -->
        <div class="accordion-item border-b lg:border-b-2 border-primary">
          <button
            class="accordion-toggle w-full flex items-center justify-between py-md text-left"
          >
            <span
              ><Heading
                htmlheading="h3"
                stylingclasses="cursor-hover"
                size="medium">Production</Heading
              ></span
            >

            <img
              src="/arrow-2.png"
              alt="Arrow"
              class="accordion-arrow h-4 transition-transform duration-300"
            />
          </button>

          <div
            class="accordion-content grid grid-rows-[0fr] transition-all duration-300 ease-in-out"
          >
            <div class="overflow-hidden">
              <Text variant="bodysmall" stylingclasses="pb-md">
                Full scale production across documentaries, campaigns and
                reality.
              </Text>
            </div>
          </div>
        </div>

        <!-- ITEM -->
        <div class="accordion-item border-b lg:border-b-2 border-primary">
          <button
            class="accordion-toggle w-full flex items-center justify-between py-md text-left"
          >
            <span
              ><Heading
                htmlheading="h3"
                stylingclasses="cursor-hover"
                size="medium">Editing</Heading
              ></span
            >

            <img
              src="/arrow-2.png"
              alt="Arrow"
              class="accordion-arrow h-4 transition-transform duration-300"
            />
          </button>

          <div
            class="accordion-content grid grid-rows-[0fr] transition-all duration-300 ease-in-out"
          >
            <div class="overflow-hidden">
              <Text variant="bodysmall" stylingclasses="pb-md">
                Editing, grading, sound design and final delivery.
              </Text>
            </div>
          </div>
        </div>

        <!-- ITEM -->
        <div class="accordion-item border-b lg:border-b-2 border-primary">
          <button
            class="accordion-toggle w-full flex items-center justify-between py-md text-left"
          >
            <span
              ><Heading
                htmlheading="h3"
                stylingclasses="cursor-hover"
                size="medium">Delivery</Heading
              ></span
            >

            <img
              src="/arrow-2.png"
              alt="Arrow"
              class="accordion-arrow h-4 transition-transform duration-300"
            />
          </button>

          <div
            class="accordion-content grid grid-rows-[0fr] transition-all duration-300 ease-in-out"
          >
            <div class="overflow-hidden">
              <Text variant="bodysmall" stylingclasses="pb-md">
                Strategic storytelling and creative direction tailored to
                audiences.
              </Text>
            </div>
          </div>
        </div>
      </div>
    </section>
    <div class="pt-2xl lg:place-self-end lg:pb-2xl">
      <Starhover />
    </div>
  </section>
</MainLayout>

<script>
  const items = document.querySelectorAll(".accordion-item");

  items.forEach((item) => {
    const button = item.querySelector(".accordion-toggle");
    const content = item.querySelector(".accordion-content");
    const arrow = item.querySelector(".accordion-arrow");

    button.addEventListener("click", () => {
      const isOpen = content.classList.contains("grid-rows-[1fr]");

      // Luk alle
      items.forEach((otherItem) => {
        otherItem
          .querySelector(".accordion-content")
          .classList.remove("grid-rows-[1fr]");

        otherItem
          .querySelector(".accordion-content")
          .classList.add("grid-rows-[0fr]");

        otherItem
          .querySelector(".accordion-arrow")
          .classList.remove("rotate-180");
      });

      // Åbn valgt item
      if (!isOpen) {
        content.classList.remove("grid-rows-[0fr]");
        content.classList.add("grid-rows-[1fr]");

        arrow.classList.add("rotate-180");
      }
    });
  });
</script>
