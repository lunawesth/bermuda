---
import MainLayout from "../layouts/MainLayout.astro";
import Heading from "../components/Heading.astro";
import Text from "../components/Text.astro";
import Button from "../components/Button.astro";
import Breaker from "../components/Breaker.astro";
import Border from "../components/Border.astro";
import Starhover from "../components/Starhover.astro";
---

<MainLayout title="Frontpage">
  <section class="px-gutter lg:px-xl grid grid-cols-2 lg:grid-cols-4">
    <div class="col-span-2 pb-3xl lg:col-span-3">
      <Heading htmlheading="h1" size="xlarge"
        >We create engaging content across news, lifestyle and reality, from
        documentaries to high-end campaigns.</Heading
      >
    </div>
    <div class="row-end-3">
      <img src="/arrow.png" alt="Pil ned" class="h-25" />
    </div>
    <div class="pb-4xl row-end-3 lg:col-start-4">
      <div>
        <Text variant="bodybold" stylingclasses="pb-sm lg:pb-xl"
          >A Copenhagen based full-service creative production company.</Text
        >
      </div>
      <Button href="about">about us</Button>
    </div>
  </section>
  <section>
    <img src="/placeholder-video.png" alt="Video af Bermudas programmer" />
    <Breaker
      titleTop="Curious?"
      titleBottom="Well, check out our work."
      link="work"
      text="see more"
    />
  </section>
  <Border />
  <section class="px-gutter lg:px-xl pt-3xl lg:py-5xl pb-2xl">
    <div class="grid lg:grid-cols-2">
      <Heading
        htmlheading="h2"
        size="xxlarge"
        stylingclasses="pb-gutter lg:pb-lg">Our services</Heading
      >
      <Text variant="bodybold" stylingclasses="pb-md"
        >We're a passionate and dedicated team that approaches every project
        with the same energy and care, no matter the scale, always striving to
        create meaningful and engaging productions together.</Text
      >
      <Button href="services">read more</Button>
    </div>
    <Starhover />
  </section>
</MainLayout>
