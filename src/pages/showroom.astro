<MainLayout title="Showroom">
  <Breaker
    titleTop="Tekst?"
    titleBottom="Tekst, tekst tekst tekst."
    text="knap"
  />
  <div class="pb-5xl"></div>
  <Textcols title="About" textVers={1}
    ><Heading size="medium"
      >We produce beautiful, emotionally, compelling, shareworthy content for
      forward thinking broadcasters and their viewers nationally and worldwide.
      We specialize in working close to our customers and take their word and
      wishes seriously. We pride ourselves to be delivering a responsive and
      individualized approach to every production.</Heading
    ></Textcols
  >
  <div class="pb-5xl"></div>
