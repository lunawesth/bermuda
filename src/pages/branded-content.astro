---
import MainLayout from "../layouts/MainLayout.astro";
import Textcols from "../components/Textcols.astro";
import Heading from "../components/Heading.astro";
import Border from "../components/Border.astro";
import Breaker from "../components/Breaker.astro";
import Card from "../components/Card.astro";

const curl =
  "https://fmdnokxzvtubtnmvhqfm.supabase.co/rest/v1/card?select=*&category=eq.branded-content";
const apikey =
  "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImZtZG5va3h6dnR1YnRubXZocWZtIiwicm9sZSI6ImFub24iLCJpYXQiOjE3NzkwNzkxOTAsImV4cCI6MjA5NDY1NTE5MH0.86hIJgtuSaa-csRd13CQtMGx65qpyYO1x0iEQanYksc";
const options = {
  headers: {
    apikey,
  },
};
const data = (await fetch(curl, options).then((res) => res.json())).sort(
  (a, b) => a.id - b.id
);
---

<MainLayout title="Branded Content">
  <Textcols title="Branded" titleBottom="Content" textVers={2}
    ><Heading htmlheading="h2" size="xsmall"
      >We are a group of hands-on, hardworking visual storytellers, who love
      what we do and take pride in creating strong, dedicated and shareworthy
      branded content for all our clients, large or small. We know that the best
      results come from a close dialogue and cooperation with the people we work
      for, and we always aim to please! With each and every production, we go
      over and above to make our clients’ wishes become a reality.</Heading
    ></Textcols
  >
  <Border />

  <section
    class="grid grid-cols-4 lg:grid-cols-3 py-2xl lg:py-5xl px-gutter lg:px-xl"
  >
    <div class="hidden lg:block"></div>
    <!-- Tom col 1 (skjult på mobil) -->
    <div
      class="col-span-3 lg:col-start-2 lg:col-span-2 grid grid-cols-1 md:grid-cols-2 gap-sm lg:gap-gutter text-left [direction:rtl]"
    >
      {data.map((card) => <Card data={card} aspectRatio="aspect-[16/9]" />)}
    </div>
  </section>

  <Border />
  <Breaker
    titleTop="Want to see more?"
    titleBottom="Check out our Productions."
    link="work"
    text="see more"
  />
</MainLayout>
