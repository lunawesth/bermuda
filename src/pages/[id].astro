---
import Heading from "../components/Heading.astro";
import MainLayout from "../layouts/MainLayout.astro";
import Text from "../components/Text.astro";
import Starhover from "../components/Starhover.astro";
import Button from "../components/Button.astro";

export async function getStaticPaths() {
  const curl = "https://fmdnokxzvtubtnmvhqfm.supabase.co/rest/v1/card?select=*";

  const apikey =
    "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImZtZG5va3h6dnR1YnRubXZocWZtIiwicm9sZSI6ImFub24iLCJpYXQiOjE3NzkwNzkxOTAsImV4cCI6MjA5NDY1NTE5MH0.86hIJgtuSaa-csRd13CQtMGx65qpyYO1x0iEQanYksc";

  const options = {
    headers: {
      apikey: apikey,
    },
  };

  const response = await fetch(curl, options);
  const data = await response.json();

  return data.map((data) => {
    return {
      params: { id: data.id },
      props: { data },
    };
  });
}

const { data } = Astro.props;
---

<MainLayout title={data.heading}>
  <Heading
    htmlheading="h2"
    size="xs"
    weight="bold"
    stylingclasses="pb-lg text-center case-font"
  >
    {data.heading}
  </Heading>
  <section class="grid lg:grid-cols-6">
    <div class="lg:col-start-2 lg:col-end-6">
      <Heading
        htmlheading="h3"
        size="medium"
        stylingclasses="text-center pb-xl case-font"
      >
        {data.descrheader}
      </Heading>
    </div>
  </section>

  <section class="relative mb-3xl lg:mb-0 grid lg:grid-cols-4">
    <div class="px-gutter lg:col-start-2 lg:col-end-4">
      <img
        src={"/" + data.image}
        alt={data.imgdescr}
        class="pb-sm lg:pb-gutter w-full"
      />
    </div>

    <div
      class="px-gutter absolute -bottom-2xl w-full lg:static lg:pt-sm lg:col-start-4 lg:col-end-5 lg:pl-4xl"
    >
      <Starhover />
    </div>
  </section>
  <section class="grid lg:grid-cols-4">
    <div class="px-gutter pb-4xl lg:col-start-2 lg:col-end-4">
      <Text stylingclasses="case-font">{data.descrbody}</Text>
    </div>
  </section>
  <section class="grid lg:grid-cols-6">
    <div class="pb-gutter lg:pb-3xl lg:col-start-2 lg:col-end-6">
      <Text stylingclasses="text-center pb-sm case-font font-bold">Trailer</Text
      >
      <img src="/placeholder-video.png" alt="Trailer." />
    </div>
  </section>
  <div class="px-gutter lg:px-xl pb-2xl lg:pb-4xl">
    <Button onclick="history.back()">go back</Button>
  </div>
</MainLayout>
