---
import Heading from "../components/Heading.astro";
import MainLayout from "../layouts/MainLayout.astro";
import Text from "../components/Text.astro";
import Starhover from "../components/Starhover.astro";
import Button from "../components/Button.astro";

export async function getStaticPaths() {
  const curl = "https://fmdnokxzvtubtnmvhqfm.supabase.co/rest/v1/card?select=*";

  const apikey =
    "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImZtZG5va3h6dnR1YnRubXZocWZtIiwicm9sZSI6ImFub24iLCJpYXQiOjE3NzkwNzkxOTAsImV4cCI6MjA5NDY1NTE5MH0.86hIJgtuSaa-csRd13CQtMGx65qpyYO1x0iEQanYksc";

  const options = {
    headers: {
      apikey: apikey,
    },
  };

  const response = await fetch(curl, options);
  const data = await response.json();

  return data.map((data) => {
    return {
      params: { id: data.id },
      props: { data },
    };
  });
}

const { data } = Astro.props;
---

<MainLayout title={data.heading}>
  <Heading htmlheading="h2" size="xs" stylingclasses="pb-lg text-center">
    {data.heading}
  </Heading>
  <section class="grid lg:grid-cols-12 lg:grid-rows-4 lg:auto-rows-max">
    <div class="lg:col-start-3 lg:col-end-11 lg:row-start-1">
      <Heading
        htmlheading="h3"
        size="medium"
        stylingclasses="text-center pb-xl"
      >
        {data.descrheader}
      </Heading>
    </div>

    <!-- Wrapper for image and Starhover -->
    <div class="relative lg:col-start-4 lg:col-end-10 lg:row-start-2">
      <img
        src={"/" + data.image}
        alt={data.imgdescr}
        class="pb-sm lg:pb-gutter w-full"
      />
      <!-- Starhover placed below the image -->
      <div class="absolute bottom-0 left-0 w-full lg:static lg:pt-sm">
        <Starhover />
      </div>
    </div>

    <div class="pb-xl lg:col-start-4 lg:col-end-10 lg:row-start-3">
      <Text>{data.descrbody}</Text>
    </div>
    <div class="lg:col-start-4 lg:col-end-10 lg:row-start-4">
      <Text stylingclasses="text-center pb-sm">Trailer</Text>
      <img src="/placeholder-video.png" alt="Trailer." />
    </div>
  </section>
  <Button onclick="history.back()">go back</Button>
</MainLayout>
