---
import Heading from "../components/Heading.astro";
import MainLayout from "../layouts/MainLayout.astro";
import Text from "../components/Text.astro";
import Starhover from "../components/Starhover.astro";
import Button from "../components/Button.astro";

export async function getStaticPaths() {
  const curl = "https://fmdnokxzvtubtnmvhqfm.supabase.co/rest/v1/card?select=*";

  const apikey =
    "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImZtZG5va3h6dnR1YnRubXZocWZtIiwicm9sZSI6ImFub24iLCJpYXQiOjE3NzkwNzkxOTAsImV4cCI6MjA5NDY1NTE5MH0.86hIJgtuSaa-csRd13CQtMGx65qpyYO1x0iEQanYksc";

  const options = {
    headers: {
      apikey: apikey,
    },
  };

  const response = await fetch(curl, options);
  const data = await response.json();

  return data.map((data) => {
    return {
      params: { id: data.id },
      props: { data },
    };
  });
}

const { data } = Astro.props;
---

<MainLayout title={data.heading}>
  <div class="px-gutter lg:px-xl">
    <div class="pb-4xl lg:pb-5xl">
      <Heading htmlheading="h2" size="xs" stylingclasses="pb-lg text-center"
        >{data.heading}</Heading
      >
      <Heading htmlheading="h3" size="medium" stylingclasses="text-center pb-xl"
        >{data.descrheader}</Heading
      >
      <img
        src={"/" + data.image}
        alt={data.imgdescr}
        class="pb-sm lg:pb-gutter"
      />
      <div class="pb-xl">
        <Starhover />
      </div>
      <Text>{data.descrbody}</Text>
    </div>
    <Text stylingclasses="text-center pb-sm">Trailer</Text>
  </div>
  <img src="/placeholder-video.png" alt="Trailer." />
  <div class="pt-xl pb-2xl lg:pt-3xl lg:pb-4xl px-gutter lg:px-xl">
    <Button onclick="history.back()">go back</Button>
  </div>
</MainLayout>
