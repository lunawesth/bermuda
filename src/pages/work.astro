---
import MainLayout from "../layouts/MainLayout.astro";
import Textcols from "../components/Textcols.astro";
import Heading from "../components/Heading.astro";
import Border from "../components/Border.astro";
import Breaker from "../components/Breaker.astro";
import Card from "../components/Card.astro";

const curl =
  "https://fmdnokxzvtubtnmvhqfm.supabase.co/rest/v1/card?select=*&category=eq.work";
const apikey =
  "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImZtZG5va3h6dnR1YnRubXZocWZtIiwicm9sZSI6ImFub24iLCJpYXQiOjE3NzkwNzkxOTAsImV4cCI6MjA5NDY1NTE5MH0.86hIJgtuSaa-csRd13CQtMGx65qpyYO1x0iEQanYksc";
const options = {
  headers: {
    apikey,
  },
};
const data = await fetch(curl, options).then((res) => res.json());
console.log(data);
---

<MainLayout title="Work">
  <Textcols title="Work" textVers={2}
    ><Heading htmlheading="h2" size="xsmall"
      >We produce beautiful, emotionally, compelling, shareworthy content for
      forward thinking broadcasters and their viewers nationally and worldwide.
      We specialize in working close to our customers and take their word and
      wishes seriously. We pride ourselves to be delivering a responsive and
      individualized approach to every production.</Heading
    ></Textcols
  >
  <Border />
  <div
    class="flex justify-end gap-sm lg:gap-gutter px-gutter lg:px-xl pt-md lg:pt-xl pb-2xl lg:pb-4xl"
  >
    <button class="filter-btn underline underline-offset-4" data-filter="tv2">
      TV2
    </button>

    <button class="filter-btn underline underline-offset-4" data-filter="dr">
      DR
    </button>

    <button
      class="filter-btn underline underline-offset-4"
      data-filter="viaplay"
    >
      Viaplay
    </button>
  </div>
  <section
    class="grid grid-cols-2 lg:grid-cols-4 gap-sm lg:gap-gutter px-gutter lg:px-xl pb-3xl lg:pb-5xl"
    id="card-grid"
  >
    {
      data.map((card) => (
        <div class="card-item" data-broadcaster={card.broadcaster}>
          <Card data={card} />
        </div>
      ))
    }
  </section>
  <Border />
  <Breaker
    titleTop="Want to see more?"
    titleBottom="Check out our Branded Content."
    link="branded-content"
    text="see more"
  />
</MainLayout>

<script>
  const buttons = document.querySelectorAll(".filter-btn");
  const cards = document.querySelectorAll(".card-item");

  buttons.forEach((button) => {
    button.addEventListener("click", () => {
      buttons.forEach((btn) => {
        btn.classList.remove("font-medium");
      });

      button.classList.add("font-medium");

      const filter = button.dataset.filter;

      cards.forEach((card) => {
        const broadcaster = card.dataset.broadcaster;

        if (filter === "all" || broadcaster === filter) {
          card.style.display = "block";
        } else {
          card.style.display = "none";
        }
      });
    });
  });
</script>
