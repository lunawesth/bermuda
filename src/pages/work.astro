---
import MainLayout from "../layouts/MainLayout.astro";
import Textcols from "../components/Textcols.astro";
import Heading from "../components/Heading.astro";
import Border from "../components/Border.astro";
import Breaker from "../components/Breaker.astro";
---

<MainLayout title="Work">
  <Textcols title="Work" textVers={2}
    ><Heading size="small"
      >We produce beautiful, emotionally, compelling, shareworthy content for
      forward thinking broadcasters and their viewers nationally and worldwide.
      We specialize in working close to our customers and take their word and
      wishes seriously. We pride ourselves to be delivering a responsive and
      individualized approach to every production.</Heading
    ></Textcols
  >
  <Border />
  <Border />
  <Breaker
    titleTop="Want to see more?"
    titleBottom="Check out our Branded Content."
    link="branded-content"
    text="see more"
  />
  <Border />
</MainLayout>
