---
import Heading from "./Heading.astro";

const { data } = Astro.props;
---

<section class="pb-xl lg:pb-3xl">
  <a href={`/${data.id}`}>
    <img
      src={"/" + data.image}
      alt={data.imgdescr}
      class="pb-sm lg:pb-gutter"
    />
    <Heading htmlheading="h2" size="xsmall">
      {data.heading}
    </Heading>
  </a>
</section>

