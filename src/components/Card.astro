---
import Heading from "./Heading.astro";

const { data, aspectRatio = "aspect-[4/5]" } = Astro.props;
---

<section class="pb-md lg:pb-xl">
  <div class={`card-item`} data-broadcaster={data.broadcaster}>
    <a href={`/${data.id}`}>
      <div class={`relative w-full ${aspectRatio} overflow-hidden`}>
        <img
          src={"/" + data.image}
          alt={data.imgdescr}
          class="absolute inset-0 w-full h-full object-cover"
        />
      </div>
      <Heading htmlheading="h2" size="xsmall" stylingclasses="pt-sm lg:pt-md">
        {data.heading}
      </Heading>
    </a>
  </div>
</section>
