---
const { href = "#", target = "_self", variant } = Astro.props;

const variants = {
  menu: "text-default text-base lg:text-2xl hover:underline hover:decoration-accent",
  menudark: "text-secondary text-3xl hover:underline hover:decoration-accent",
  footer:
    "text-default text-base pr-gutter lg:pr-2xl lg:text-3xl hover:bg-accent",
};

const classes = variants[variant] || "";
---

<a href={href} class={`${classes}`} target={target}>
  <slot />
</a>
