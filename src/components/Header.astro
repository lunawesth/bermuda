---
import Link from "./Link.astro";
---

<link
  href="https://fonts.googleapis.com/icon?family=Material+Icons"
  rel="stylesheet"
/>

<section class="z-50 relative">
  <!-- grøn top -->
  <div class="bg-nav-green pt-lg"></div>

  <!-- navbar -->
  <div
    class="bg-nav pt-md lg:pt-gutter flex items-center justify-between pl-md pr-lg"
  >
    <!-- logo -->
    <span>
      <a href="/" class="absolute top-11 z-70">
        <div class="relative">
          <!-- Sort logo (standard) -->
          <img
            id="logo-black"
            src="/logo.png"
            alt="Bermuda logo"
            class="h-8.25 lg:h-12 cursor-hover"
          />
          <!-- Hvidt logo (skjult som standard) -->
          <img
            id="logo-white"
            src="/logo-white.png"
            alt="Bermuda logo"
            class="h-8.25 lg:h-12 z-100 hidden"
          />
        </div>
      </a>
    </span>

    <!-- desktop menu -->
    <div class="hidden lg:block">
      <ul class="flex flex-row gap-2xl">
        <li><Link href="/work" variant="menu">work</Link></li>
        <li>
          <Link href="/branded-content" variant="menu">branded content</Link>
        </li>
        <li><Link href="/services" variant="menu">services</Link></li>
        <li><Link href="/about" variant="menu">about</Link></li>
        <li><Link href="/contact" variant="menu">contact</Link></li>
      </ul>
    </div>

    <!-- mobile menu -->
    <button
      id="menu-btn"
      class="lg:hidden z-70 flex items-center gap-2 text-default"
    >
      menu
      <span id="menu-icon" class="material-icons">expand_more</span>
    </button>

    <div
      id="mobile-menu"
      class="fixed top-0 left-0 w-full h-screen bg-nav-dark lg:hidden -translate-y-[100%] transition-transform duration-500 ease-in-out pt-5xl pl-gutter z-60"
    >
      <div class="flex flex-col gap-md">
        <Link href="/" variant="menudark">frontpage</Link>
        <Link href="/work" variant="menudark">work</Link>
        <Link href="/branded-content" variant="menudark">branded content</Link>
        <Link href="/services" variant="menudark">services</Link>
        <Link href="/about" variant="menudark">about</Link>
        <Link href="/contact" variant="menudark">contact</Link>
      </div>
    </div>
  </div>
</section>

<script client:load>
  const menuBtn = document.getElementById("menu-btn");
  const menuIcon = document.getElementById("menu-icon");
  const mobileMenu = document.getElementById("mobile-menu");
  const logoBlack = document.getElementById("logo-black");
  const logoWhite = document.getElementById("logo-white");
  const body = document.body;

  menuBtn?.addEventListener("click", () => {
    if (mobileMenu.classList.contains("-translate-y-[100%]")) {
      // Åbn menuen
      mobileMenu.classList.remove("-translate-y-[100%]");
      mobileMenu.classList.add("translate-y-0");
      menuBtn.classList.remove("text-default");
      menuBtn.classList.add("text-secondary"); // Skift skriftfarve til hvid
      menuIcon.textContent = "expand_less"; // Skift pil til opad
      logoBlack.classList.add("hidden"); // Skjul sort logo
      logoWhite.classList.remove("hidden"); // Vis hvidt logo
      body.classList.add("overflow-hidden"); // Forhindrer scrolling
    } else {
      // Luk menuen
      mobileMenu.classList.add("-translate-y-[100%]");
      mobileMenu.classList.remove("translate-y-0");
      menuBtn.classList.remove("text-secondary");
      menuBtn.classList.add("text-default"); // Skift skriftfarve til sort
      menuIcon.textContent = "expand_more"; // Skift pil til nedad
      logoBlack.classList.remove("hidden"); // Vis sort logo
      logoWhite.classList.add("hidden"); // Skjul hvidt logo
      body.classList.remove("overflow-hidden"); // Tillader scrolling igen
    }
  });
</script>
