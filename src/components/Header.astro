---
import Link from "./Link.astro";
---

<link
  href="https://fonts.googleapis.com/icon?family=Material+Icons"
  rel="stylesheet"
/>

<section>
  <!-- grøn top -->
  <div class="bg-nav-green py-lg"></div>

  <!-- navbar -->
  <div class="bg-nav py-lg flex items-center justify-between pl-md pr-lg">
    <!-- logo -->
    <div class="relative">
      <!-- Sort logo (standard) -->
      <img
        id="logo-black"
        src="/logo.png"
        alt="Bermuda logo"
        class="h-8.25 md:h-12"
      />
      <!-- Hvidt logo (skjult som standard) -->
      <img
        id="logo-white"
        src="/logo-white.png"
        alt="Bermuda logo"
        class="h-8.25 md:h-12 z-50 hidden"
      />
    </div>

    <!-- desktop menu -->
    <div class="hidden lg:block">
      <ul class="flex flex-row gap-2xl">
        <li><Link href="" variant="menu">work</Link></li>
        <li><Link href="" variant="menu">branded content</Link></li>
        <li><Link href="" variant="menu">services</Link></li>
        <li><Link href="" variant="menu">about</Link></li>
        <li><Link href="" variant="menu">contact</Link></li>
      </ul>
    </div>

    <!-- mobile menu -->
    <button
      id="menu-btn"
      class="lg:hidden z-50 flex items-center gap-2 text-black"
      aria-label="Open menu"
    >
      menu
      <span id="menu-icon" class="material-icons">expand_more</span>
    </button>

    <div
      id="mobile-menu"
      class="absolute top-0 left-0 w-full h-screen bg-nav-dark lg:hidden -translate-y-full transition-transform duration-500 ease-in-out pt-5xl pl-gutter"
    >
      <div class="flex flex-col gap-md">
        <Link href="" variant="menudark">work</Link>
        <Link href="" variant="menudark">branded content</Link>
        <Link href="" variant="menudark">services</Link>
        <Link href="" variant="menudark">about</Link>
        <Link href="" variant="menudark">contact</Link>
      </div>
    </div>

    <script>
      const menuBtn = document.getElementById("menu-btn");
      const menuIcon = document.getElementById("menu-icon");
      const mobileMenu = document.getElementById("mobile-menu");
      const logoBlack = document.getElementById("logo-black");
      const logoWhite = document.getElementById("logo-white");
      const body = document.body;

      menuBtn?.addEventListener("click", () => {
        if (mobileMenu.classList.contains("-translate-y-full")) {
          // Åbn menuen
          mobileMenu.classList.remove("-translate-y-full");
          mobileMenu.classList.add("translate-y-0");
          menuBtn.classList.remove("text-black");
          menuBtn.classList.add("text-white"); // Skift skriftfarve til hvid
          menuIcon.textContent = "expand_less"; // Skift pil til opad
          logoBlack.classList.add("hidden"); // Skjul sort logo
          logoWhite.classList.remove("hidden"); // Vis hvidt logo
          body.classList.add("overflow-hidden"); // Forhindrer scrolling
        } else {
          // Luk menuen
          mobileMenu.classList.add("-translate-y-full");
          mobileMenu.classList.remove("translate-y-0");
          menuBtn.classList.remove("text-white");
          menuBtn.classList.add("text-black"); // Skift skriftfarve til sort
          menuIcon.textContent = "expand_more"; // Skift pil til nedad
          logoBlack.classList.remove("hidden"); // Vis sort logo
          logoWhite.classList.add("hidden"); // Skjul hvidt logo
          body.classList.remove("overflow-hidden"); // Tillader scrolling igen
        }
      });
    </script>
  </div>
</section>
